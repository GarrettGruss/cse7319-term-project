# GitHub Personal Access Token
# Create a classic token (NOT FINE GRAINED) at: https://github.com/settings/tokens
# Required scopes: repo (for private repos), read:org
GITHUB_PAT=your_github_personal_access_token_here

# GitHub Organization name
GITHUB_ORG=your_github_org_name

# OpenObserve Configuration
# Root user email for OpenObserve
ZO_ROOT_USER_EMAIL=admin@example.com

# Root user password for OpenObserve
ZO_ROOT_USER_PASSWORD=Complexpass#123

# OpenObserve endpoint (for local Docker setup, use the default)
# For external instance, use: https://your-instance.openobserve.ai/api/default/
OPENOBSERVE_ENDPOINT=http://openobserve:5080/api/default/

# OpenObserve Basic auth token
# Format: base64 encoded "email:password"
# You can generate this with: echo -n "admin@example.com:Complexpass#123" | base64
# For the default credentials above, use: YWRtaW5AZXhhbXBsZS5jb206Q29tcGxleHBhc3MjMTIz
OPENOBSERVE_TOKEN=YWRtaW5AZXhhbXBsZS5jb206Q29tcGxleHBhc3MjMTIz
